<!DOCTYPE html>
<html>
  <head>
  	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title><%= title %></title>
    <link rel='stylesheet' href='/css/style.css' />

    <script type="text/javascript" src="/js/jquery-1.7.1.min.js"></script>
	<script type="text/javascript" src="/js/worldcup.js"></script>
  </head>
  <body>
    <div class="wrap">
		<h1>Friends World Cup</h1>
		<div id="intro" class="box2">
			<div class="noti">
			<h2>How to play</h2>
			<ol>
				<li>Prepare image files of the people who will be the candidates.</li>
				<li>Click the file select button and choose the image files you prepared.</li>
			</ol>
			<p><input id="file" type="file" multiple></p>
			</div>
		</div>
		<div id="game" class="box">
		    <h2 id="round_title"></h2>
			<div class="frame"><img id="left_image" src="images/no_contact_icon.png"><div id="left_name" class="name">Anonymous</div></div>
			<div class="frame"><img id="right_image" src="images/no_contact_icon.png"><div id="right_name" class="name">Anonymous</div></div>
			<div class="vs"></div>
		</div>
		<div id="winner" class="box2">
			<div class="frame">
				<img id="winner_image" src="images/no_contact_icon.png">
				<div id="winner_name" class="name">Anonymous</div>
				<button id="newgame">New Game</button>
			</div>
			<div class="congratulation"></div>
		</div>
	</div>
  </body>
</html>